#!/bin/sh
# Every start: host keys if missing, and the user's key from the FAT partition.
set -e
ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1 || ssh-keygen -A
SRC=/boot/authorized_keys
[ -f "$SRC" ] || [ ! -f /boot/authorized_keys.txt ] || SRC=/boot/authorized_keys.txt
if [ -f "$SRC" ]; then
    install -d -m 700 /root/.ssh
    tr -d '\r' < "$SRC" > /root/.ssh/authorized_keys.new
    chmod 600 /root/.ssh/authorized_keys.new
    mv /root/.ssh/authorized_keys.new /root/.ssh/authorized_keys
fi
# A key is there and the default password was never changed (last change = day 0):
# switch the default password off, the key is the login. "passwd" sets a new one.
if [ -s /root/.ssh/authorized_keys ] && [ "$(awk -F: '$1=="root"{print $3}' /etc/shadow)" = 0 ]; then
    usermod -p '*' root
    chage -d 1 root
fi
