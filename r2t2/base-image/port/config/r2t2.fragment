CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_764369=y
CONFIG_ARM_ERRATA_775420=y
CONFIG_PL310_ERRATA_753970=y
CONFIG_PL310_ERRATA_769419=y
# Debian armhf userland is Thumb-2; without this /sbin/init fails with ENOEXEC
CONFIG_ARM_THUMB=y
CONFIG_KUSER_HELPERS=y
# older 32-bit time syscalls, for binaries built against an older libc
CONFIG_COMPAT_32BIT_TIME=y
# namespaces for the sandboxing options of systemd units
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
# resize2fs/tune2fs open the mounted root device for writing (first-start growth)
CONFIG_BLK_DEV_WRITE_MOUNTED=y
